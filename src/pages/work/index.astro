---
import MainLayout from '../../layouts/MainLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectorNav from '../../components/SectorNav.astro';
import CTASection from '../../components/CTASection.astro';
import { getWorkBySector } from '../../data/work';
import { nextSteps } from '../../data/next-steps';
import { site } from '../../data/site';

const sectors = await getWorkBySector();
---

<MainLayout
  title={`Work — 360° Virtual Tours & Photography | ${site.name}`}
  description="Interactive 360° walkthroughs and photography for restaurants, hotels, showrooms, offices, schools and venues across Northern Ireland. Step inside the work."
>
  <PageIntro
    eyebrow="Work"
    title="Find a business like yours."
    intro="Every example here is a real space, photographed and built by Karl. Step inside any of them."
  />

  <div class="container-wide pb-16">
    <SectorNav />
  </div>

  {sectors.length > 0 ? (
    sectors.map((sector) => (
      <section id={sector.id} class="scroll-mt-8 border-t border-material-stone/15 py-16 lg:py-20">
        <div class="container-wide">
          <h2 class="font-display text-3xl font-light text-material-charcoal">{sector.label}</h2>
          <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {sector.entries.map((entry) => <ProjectCard entry={entry} />)}
          </div>
        </div>
      </section>
    ))
  ) : (
    <div class="container-wide pb-24">
      <p class="text-material-charcoal/60">More work is on the way.</p>
    </div>
  )}

  <CTASection {...nextSteps} tone="forest" />
</MainLayout>
