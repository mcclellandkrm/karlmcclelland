---
import MainLayout from '../layouts/MainLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
---

<MainLayout title={`Page not found | ${site.name}`} noindex>
  <PageIntro eyebrow="404" title="This page has moved or no longer exists." />
  <div class="container-wide pb-24 lg:pb-32">
    <a href="/" class="text-label text-material-bronze transition-colors duration-300 hover:text-material-charcoal">
      Back to the homepage →
    </a>
  </div>
</MainLayout>
