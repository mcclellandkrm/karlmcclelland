---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ClientLogoGrid from '../components/ClientLogoGrid.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import Stats from '../components/Stats.astro';
import CTASection from '../components/CTASection.astro';
import { nextSteps } from '../data/next-steps';
import { site } from '../data/site';
import { featuredTestimonial } from '../data/proof';

const quotes = [
  featuredTestimonial,
  ...(await getCollection('work', ({ data }) => Boolean(data.quote) && !data.draft)).map((entry) => entry.data.quote!),
];
---

<MainLayout
  title={`Clients | ${site.name}`}
  description="Brands and businesses Karl McClelland has photographed and built 360° walkthroughs for, from Toyota and Hilti to the Lyric Theatre and SSE Arena."
>
  <PageIntro
    eyebrow="Clients"
    title="Trusted by names you'll recognise."
    intro="A selection of businesses and organisations I have photographed and created walkthroughs for."
  />

  <div class="container-wide pb-24 lg:pb-32">
    <div class="mb-16"><Stats /></div>
    <ClientLogoGrid />
  </div>

  {quotes.length > 0 && (
    <div class="border-t border-material-stone/15 bg-material-limestone py-20 lg:py-28">
      <div class="container-wide space-y-20">
        {quotes.map((quote) => (
          <QuoteBlock text={quote.text} attribution={quote.attribution} role={quote.role} />
        ))}
      </div>
    </div>
  )}

  <CTASection {...nextSteps} tone="forest" />
</MainLayout>
