---
const essentialFeatures = [
  '6 Professional 360° Panospheres',
  'Published to Google Business Profile',
  '25+ High-Res Marketing Images',
  'Website Embed Codes',
  'Full Commercial Usage Rights',
  'Google Street View Integration',
];

const professionalFeatures = [
  '10 Professional 360° Panospheres',
  'Custom Branded Hotspots',
  '35+ High-Res Marketing Images',
  'Interactive Floor Plan',
  'Social Media Content Package',
  'Priority Google Publishing',
  '6 Months Support Included',
];

const premiumFeatures = [
  'Unlimited Scenes & Hotspots',
  'Fully Branded Experience',
  'Info Panels & Booking Integration',
  'Hosted on Your Domain',
  '50+ High-Res Marketing Images',
  'Video Integration Options',
  '12 Months Support Included',
];
---

<section id="offerings" class="section bg-neutral-900 relative overflow-hidden">
  <!-- Cinematic Fog Background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neutral-800 via-neutral-900 to-black opacity-80"></div>

  <div class="container-wide relative z-10">

    <!-- Header -->
    <div data-reveal class="text-center mb-16">
      <span class="text-label block mb-4 text-brand-stone">SERVICES & PRICING</span>
      <h2 class="text-4xl md:text-5xl font-display text-white mb-4 font-light">
        Premium 360° Walkthroughs
      </h2>
      <p class="text-base leading-relaxed text-neutral-300 max-w-2xl mx-auto font-body">
        Google-certified 360° walkthroughs, real photography of your actual space, that turn browsers into bookers. One-time investment, lifetime results.
      </p>
    </div>

    <!-- Three Tiers -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-8">

      <!-- Essential Package -->
      <div data-reveal class="group relative">
        <div class="absolute -inset-1 bg-gradient-to-br from-neutral-800 to-neutral-900 blur opacity-30 group-hover:opacity-75 transition-all duration-700"></div>
        <div class="relative bg-neutral-900/80 border border-neutral-800 p-8 lg:p-10 h-full backdrop-blur-sm">
          <span class="text-[10px] font-mono text-neutral-500 tracking-[0.3em] block mb-4">
            ESSENTIAL
          </span>
          <h3 class="text-2xl font-display text-neutral-400 font-light mb-6">
            Local Business
          </h3>
          <div class="flex items-baseline gap-2 mb-6">
            <span class="text-4xl font-display font-light text-white">£599</span>
            <span class="text-neutral-500 text-sm">one-time</span>
          </div>

          <p class="text-base leading-relaxed mb-8 text-neutral-400">
            Perfect for cafes, salons, retail shops, and restaurants. Get found on Google Maps and stand out locally.
          </p>

          <ul class="space-y-4 mb-10">
            {essentialFeatures.map((item) => (
              <li class="flex gap-3 text-base text-neutral-400">
                <span class="text-neutral-600 mt-1">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" class="btn-secondary w-full text-center justify-center block">
            Book Now
          </a>
        </div>
      </div>

      <!-- Professional Package -->
      <div data-reveal style="transition-delay: 0.1s" class="group relative">
        <div class="absolute -inset-1 bg-gradient-to-br from-accent-warm/20 to-accent-ember/20 blur opacity-40 group-hover:opacity-80 transition-all duration-700"></div>
        <div class="relative bg-neutral-900/90 border border-accent-warm/30 p-8 lg:p-10 h-full backdrop-blur-sm">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[10px] font-mono text-accent-warm tracking-[0.3em]">
              PROFESSIONAL
            </span>
            <span class="text-[10px] font-mono bg-accent-warm/20 text-accent-warm px-2 py-1 rounded">
              MOST POPULAR
            </span>
          </div>
          <h3 class="text-2xl font-display text-white font-light mb-6">
            Hospitality & Retail
          </h3>
          <div class="flex items-baseline gap-2 mb-6">
            <span class="text-4xl font-display font-light text-white">£899</span>
            <span class="text-neutral-400 text-sm">one-time</span>
          </div>

          <p class="text-base leading-relaxed mb-8 text-neutral-300">
            Enhanced experience for hotels, restaurants, and premium retail. Includes branded elements and extended coverage.
          </p>

          <ul class="space-y-4 mb-10">
            {professionalFeatures.map((item) => (
              <li class="flex gap-3 text-base text-neutral-300">
                <span class="text-accent-warm mt-1">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" class="btn-primary w-full text-center justify-center block">
            Book Now
          </a>
        </div>
      </div>

      <!-- Premium Package -->
      <div data-reveal style="transition-delay: 0.2s" class="group relative">
        <div class="absolute -inset-1 bg-gradient-to-br from-white/30 via-white/20 to-neutral-800 blur opacity-60 group-hover:opacity-100 transition-all duration-700"></div>
        <div class="relative bg-neutral-900/90 border border-white/20 p-8 lg:p-10 h-full backdrop-blur-sm">
          <span class="text-[10px] font-mono text-neutral-400 tracking-[0.3em] block mb-4">
            PREMIUM
          </span>
          <h3 class="text-2xl font-display text-white font-light mb-6">
            Luxury Experiences
          </h3>
          <div class="flex items-baseline gap-2 mb-6">
            <span class="text-4xl font-display font-light text-white">£1,499</span>
            <span class="text-neutral-400 text-sm">one-time</span>
          </div>

          <p class="text-base leading-relaxed mb-8 text-neutral-200">
            Bespoke 360° walkthroughs for luxury properties, hotels, and high-end brands. Fully customized storytelling experience.
          </p>

          <ul class="space-y-4 mb-10">
            {premiumFeatures.map((item) => (
              <li class="flex gap-3 text-base text-neutral-200">
                <span class="text-white/80 mt-1">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" class="btn-primary w-full text-center justify-center block">
            Get a Quote
          </a>
        </div>
      </div>

    </div>

    <!-- Supporting services -->
    <p data-reveal style="transition-delay: 0.25s" class="text-center text-sm text-neutral-500 mt-12 max-w-xl mx-auto">
      Also available: professional photography, drone/aerial, and website builds — the pieces that make a business easy to find and easy to choose.
    </p>

    <!-- CTA -->
    <div data-reveal style="transition-delay: 0.3s" class="text-center mt-10">
      <a href="#contact" class="btn-primary">
        Start Your Project
      </a>
    </div>

  </div>
</section>
