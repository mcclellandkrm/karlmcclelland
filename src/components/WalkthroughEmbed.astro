---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Click-to-load walkthrough. Tour players are heavy, so nothing loads until
// the visitor asks for it; the poster (a real still) carries the page until
// then. Falls back to a plain link if JavaScript is unavailable.
interface Props {
  src: string;
  title: string;
  poster?: ImageMetadata;
  // 'fill' takes the parent's size (e.g. the homepage hero).
  aspect?: 'wide' | 'standard' | 'fill';
  // Set on the hero so the poster isn't lazy-loaded above the fold.
  eager?: boolean;
}

const { src, title, poster, aspect = 'wide', eager = false } = Astro.props;

const posterImage = poster ? await getImage({ src: poster, width: 1800, format: 'webp' }) : null;
const aspectClass = { wide: 'aspect-[16/9]', standard: 'aspect-[4/3]', fill: 'h-full' }[aspect];
---

<div
  class:list={['walkthrough relative w-full overflow-hidden bg-material-charcoal', aspectClass]}
  data-walkthrough-src={src}
  data-walkthrough-title={title}
>
  {posterImage && (
    <img
      src={posterImage.src}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
  )}
  <div class:list={['absolute inset-0', posterImage ? 'bg-material-charcoal/35' : 'bg-material-charcoal']}></div>

  <button
    type="button"
    class="walkthrough-start absolute inset-0 flex flex-col items-center justify-center gap-4 text-white"
    aria-label={`Explore the ${title} walkthrough`}
  >
    <span class="flex h-20 w-20 items-center justify-center rounded-full border border-white/60 transition-colors duration-300 hover:border-white hover:bg-white/10">
      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke-width="1.25"></circle>
        <ellipse cx="12" cy="12" rx="4" ry="9" stroke-width="1.25"></ellipse>
        <path d="M3 12h18" stroke-width="1.25"></path>
      </svg>
    </span>
    <span class="text-label text-white">Step inside</span>
  </button>

  <noscript>
    <a href={src} target="_blank" rel="noopener noreferrer" class="absolute inset-0 flex items-end p-6 text-label text-white">
      Open the walkthrough →
    </a>
  </noscript>
</div>

<script>
  // Desktop: the tour loads in place. Phones and small tablets: it opens full
  // screen over the page with a Close bar, because tours have their own menus
  // and controls that don't fit (or fight page scrolling) in a small inline box.
  // The phone's back gesture also closes it.
  const SMALL_SCREEN = window.matchMedia('(max-width: 1023px)');

  const makeFrame = (src: string, title: string) => {
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = `${title}, interactive 360° view`;
    iframe.allow = 'fullscreen; accelerometer; gyroscope; magnetometer; xr-spatial-tracking';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    return iframe;
  };

  let closeOverlay: (() => void) | null = null;

  const openOverlay = (src: string, title: string, returnFocus: HTMLElement) => {
    const overlay = document.createElement('div');
    overlay.className = 'fixed inset-0 z-[60] flex flex-col bg-material-charcoal';
    overlay.style.height = '100dvh';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', `${title}, 360° view`);

    const bar = document.createElement('div');
    bar.className = 'flex h-14 shrink-0 items-center justify-between gap-4 border-b border-white/10 px-4 text-white';
    const label = document.createElement('span');
    label.className = 'truncate text-sm text-white/80';
    label.textContent = title;
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'flex shrink-0 items-center gap-2 border border-white/40 px-4 py-2 text-xs font-semibold uppercase tracking-wider';
    close.innerHTML = '<span aria-hidden="true">✕</span> Close';
    bar.append(label, close);

    const stage = document.createElement('div');
    stage.className = 'relative flex-1';
    stage.append(makeFrame(src, title));
    overlay.append(bar, stage);
    document.body.append(overlay);
    document.body.classList.add('overflow-hidden');
    close.focus();

    // Let the back gesture close the tour instead of leaving the page.
    history.pushState({ walkthroughOverlay: true }, '');

    const teardown = () => {
      overlay.remove(); // also stops the tour (and any sound)
      document.body.classList.remove('overflow-hidden');
      window.removeEventListener('popstate', teardown);
      document.removeEventListener('keydown', onKey);
      closeOverlay = null;
      returnFocus.focus();
    };
    const onKey = (event: KeyboardEvent) => event.key === 'Escape' && history.back();
    window.addEventListener('popstate', teardown);
    document.addEventListener('keydown', onKey);
    close.addEventListener('click', () => history.back());
    closeOverlay = teardown;
  };

  document.querySelectorAll<HTMLElement>('[data-walkthrough-src]').forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>('.walkthrough-start');
    button?.addEventListener('click', () => {
      const src = container.dataset.walkthroughSrc ?? '';
      const title = container.dataset.walkthroughTitle ?? 'Walkthrough';
      if (SMALL_SCREEN.matches) {
        if (!closeOverlay) openOverlay(src, title, button);
        return;
      }
      const iframe = makeFrame(src, title);
      container.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
