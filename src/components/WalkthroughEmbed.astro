---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Click-to-load walkthrough. Tour players are heavy, so nothing loads until
// the visitor asks for it; the poster (a real still) carries the page until
// then. Falls back to a plain link if JavaScript is unavailable.
interface Props {
  src: string;
  title: string;
  poster?: ImageMetadata;
  aspect?: 'wide' | 'standard';
}

const { src, title, poster, aspect = 'wide' } = Astro.props;

const posterImage = poster ? await getImage({ src: poster, width: 1800, format: 'webp' }) : null;
const aspectClass = aspect === 'wide' ? 'aspect-[16/9]' : 'aspect-[4/3]';
---

<div
  class:list={['walkthrough relative w-full overflow-hidden bg-material-charcoal', aspectClass]}
  data-walkthrough-src={src}
  data-walkthrough-title={title}
>
  {posterImage && (
    <img
      src={posterImage.src}
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
  )}
  <div class:list={['absolute inset-0', posterImage ? 'bg-material-charcoal/35' : 'bg-material-charcoal']}></div>

  <button
    type="button"
    class="walkthrough-start absolute inset-0 flex flex-col items-center justify-center gap-4 text-white"
    aria-label={`Explore the ${title} walkthrough`}
  >
    <span class="flex h-20 w-20 items-center justify-center rounded-full border border-white/60 transition-colors duration-300 hover:border-white hover:bg-white/10">
      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke-width="1.25"></circle>
        <ellipse cx="12" cy="12" rx="4" ry="9" stroke-width="1.25"></ellipse>
        <path d="M3 12h18" stroke-width="1.25"></path>
      </svg>
    </span>
    <span class="text-label text-white">Step inside</span>
  </button>

  <noscript>
    <a href={src} target="_blank" rel="noopener noreferrer" class="absolute inset-0 flex items-end p-6 text-label text-white">
      Open the walkthrough →
    </a>
  </noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-walkthrough-src]').forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>('.walkthrough-start');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = container.dataset.walkthroughSrc ?? '';
      iframe.title = `${container.dataset.walkthroughTitle ?? 'Walkthrough'} — interactive 360° walkthrough`;
      iframe.allow = 'fullscreen; accelerometer; gyroscope; magnetometer; xr-spatial-tracking';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      container.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
