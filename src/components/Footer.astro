---
import { Image } from 'astro:assets';
import logoLockup from '../assets/brand/logo-lockup.svg';

const currentYear = new Date().getFullYear();
---

<footer class="bg-black border-t border-neutral-800">
  <div class="container-wide py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- Brand -->
      <div>
        <Image src={logoLockup} alt="Karl McClelland" class="h-10 w-auto mb-4" />
        <p class="text-neutral-400 leading-relaxed mb-6">
          Real 360° walkthroughs, published to Google, for businesses across Northern Ireland and beyond.
        </p>
        <div class="flex gap-4">
          <a
            href="https://www.linkedin.com/in/karlmcclelland"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:border-white transition-all duration-300"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-[0.3em] text-neutral-400 mb-6">Quick Links</h4>
        <ul class="space-y-3">
          <li>
            <a href="#offerings" class="group relative text-neutral-400 hover:text-white transition-colors duration-300">
              Offerings
              <span class="absolute bottom-[-2px] left-0 h-[1px] w-0 bg-accent-ember transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
          <li>
            <a href="#work" class="group relative text-neutral-400 hover:text-white transition-colors duration-300">
              Work
              <span class="absolute bottom-[-2px] left-0 h-[1px] w-0 bg-accent-ember transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
          <li>
            <a href="#process" class="group relative text-neutral-400 hover:text-white transition-colors duration-300">
              Process
              <span class="absolute bottom-[-2px] left-0 h-[1px] w-0 bg-accent-ember transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
          <li>
            <a href="#contact" class="group relative text-neutral-400 hover:text-white transition-colors duration-300">
              Contact
              <span class="absolute bottom-[-2px] left-0 h-[1px] w-0 bg-accent-ember transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-[0.3em] text-neutral-400 mb-6">Get In Touch</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="mailto:me@karlmcclelland.com"
              class="group relative text-neutral-400 hover:text-white transition-colors duration-300 flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              me@karlmcclelland.com
              <span class="absolute bottom-[-2px] left-6 h-[1px] w-0 bg-accent-ember transition-all duration-300 group-hover:w-[calc(100%-24px)]"></span>
            </a>
          </li>
          <li>
            <a
              href="tel:+447960044486"
              class="group relative text-neutral-400 hover:text-white transition-colors duration-300 flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +44 7960 044 486
              <span class="absolute bottom-[-2px] left-6 h-[1px] w-0 bg-accent-ember transition-all duration-300 group-hover:w-[calc(100%-24px)]"></span>
            </a>
          </li>
          <li class="text-neutral-400 flex items-start gap-2">
            <svg class="w-4 h-4 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Belfast, Northern Ireland
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-neutral-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-neutral-500 text-sm">
        © {currentYear} Karl McClelland. All rights reserved.
      </p>
      <p class="text-neutral-500 text-sm">
        Google Street View Trusted Photographer
      </p>
    </div>
  </div>
</footer>
