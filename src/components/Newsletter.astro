---
// Updates sign-up (Formspree). Built to actually work:
// - email required, first name optional, consent box unticked and required
// - inline, screen-reader friendly errors (no browser pop-ups)
// - honeypot field for bots; Formspree drops anything that fills it
// - the exact consent wording is stored with each sign-up as a record
// - works without JavaScript (plain POST to Formspree)
import { site } from '../data/site';

interface Props {
  // Unique per page instance so ids don't clash.
  id?: string;
}
const { id = 'updates' } = Astro.props;

const consentText = `Yes, email me occasional updates from ${site.person}. I can unsubscribe at any time.`;
const action = `https://formspree.io/f/${site.formspreeUpdatesId}`;
---

<div class="newsletter" data-newsletter>
  <form
    action={action}
    method="POST"
    class="newsletter-form"
    data-id={id}
    aria-labelledby={`${id}-heading`}
  >
    <h2 id={`${id}-heading`} class="font-display text-2xl font-normal text-white">Occasional updates</h2>
    <p class="mt-3 max-w-md leading-relaxed text-white/60">
      New work, new services and the odd project I think you'd want to see. Only when there is
      something worth sending. Your address is never shared.
    </p>

    <input type="hidden" name="_subject" value="Website: updates sign-up" />
    <input type="hidden" name="form" value="Updates sign-up" />
    <input type="hidden" name="consent_text" value={consentText} />
    <div class="hidden" aria-hidden="true">
      <label for={`${id}-gotcha`}>Leave this empty</label>
      <input type="text" id={`${id}-gotcha`} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-[1fr_1.4fr]">
      <div>
        <label for={`${id}-name`} class="mb-2 block text-label text-white/50">First name (optional)</label>
        <input
          type="text"
          id={`${id}-name`}
          name="first_name"
          autocomplete="given-name"
          class="w-full border-b border-white/30 bg-transparent pb-3 text-base text-white outline-none transition-colors duration-300 focus:border-white"
        />
      </div>
      <div>
        <label for={`${id}-email`} class="mb-2 block text-label text-white/50">Email</label>
        <input
          type="email"
          id={`${id}-email`}
          name="email"
          autocomplete="email"
          required
          aria-describedby={`${id}-email-error`}
          class="w-full border-b border-white/30 bg-transparent pb-3 text-base text-white outline-none transition-colors duration-300 focus:border-white aria-[invalid=true]:border-material-copper"
        />
        <p id={`${id}-email-error`} class="mt-2 hidden text-sm text-material-copper-light" data-error="email"></p>
      </div>
    </div>

    <div class="mt-6">
      <div class="flex items-start gap-3">
        <input
          type="checkbox"
          id={`${id}-consent`}
          name="consent"
          value="yes"
          required
          aria-describedby={`${id}-consent-error`}
          class="mt-1 h-5 w-5 shrink-0 cursor-pointer accent-material-bronze"
        />
        <label for={`${id}-consent`} class="cursor-pointer text-sm leading-relaxed text-white/70">
          {consentText}{' '}
          <a href="/privacy/" class="underline underline-offset-4 hover:text-white">How I handle your details</a>.
        </label>
      </div>
      <p id={`${id}-consent-error`} class="mt-2 hidden pl-8 text-sm text-material-copper-light" data-error="consent"></p>
    </div>

    <button
      type="submit"
      class="mt-8 inline-flex items-center justify-center border-2 border-white px-8 py-4 text-xs font-semibold uppercase tracking-wider text-white transition-colors duration-300 hover:bg-white hover:text-material-charcoal disabled:cursor-not-allowed disabled:opacity-60"
    >
      Sign up
    </button>

    <p class="mt-4 hidden text-sm text-material-copper-light" role="alert" data-error="form"></p>
  </form>

  <div class="newsletter-success hidden" role="status" tabindex="-1">
    <h2 class="font-display text-2xl font-normal text-white">You're on the list.</h2>
    <p class="mt-3 max-w-md leading-relaxed text-white/60">
      Thank you. I'll only be in touch when there is something worth seeing. To stop at any time, reply
      to any email or write to <a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-white">{site.email}</a>.
    </p>
  </div>
</div>

<script>
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLElement>('[data-newsletter]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form');
    const success = root.querySelector<HTMLElement>('.newsletter-success');
    if (!form || !success) return;

    // JS takes over validation so messages are inline and consistent.
    form.noValidate = true;

    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const errorEl = (key: string) => form.querySelector<HTMLElement>(`[data-error="${key}"]`)!;

    const setError = (key: string, input: HTMLInputElement | null, message: string) => {
      const el = errorEl(key);
      el.textContent = message;
      el.classList.toggle('hidden', !message);
      if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const validate = () => {
      let firstInvalid: HTMLInputElement | null = null;
      const value = email.value.trim();
      if (!value) {
        setError('email', email, 'Please enter your email address.');
        firstInvalid = email;
      } else if (!EMAIL_PATTERN.test(value)) {
        setError('email', email, 'That email address does not look quite right.');
        firstInvalid = email;
      } else {
        setError('email', email, '');
      }
      if (!consent.checked) {
        setError('consent', consent, 'Please tick the box so I have your permission to email you.');
        firstInvalid ??= consent;
      } else {
        setError('consent', consent, '');
      }
      return firstInvalid;
    };

    // Clear an error as soon as it is fixed.
    email.addEventListener('input', () => email.getAttribute('aria-invalid') === 'true' && validate());
    consent.addEventListener('change', () => consent.getAttribute('aria-invalid') === 'true' && validate());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setError('form', null, '');
      const invalid = validate();
      if (invalid) {
        invalid.focus();
        return;
      }

      button.disabled = true;
      button.textContent = 'Signing up...';
      email.value = email.value.trim();

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.focus();
          return;
        }

        const data = await response.json().catch(() => null);
        const emailProblem = data?.errors?.find((e: { field?: string }) => e.field === 'email');
        if (emailProblem) {
          setError('email', email, 'That email address does not look quite right.');
          email.focus();
        } else {
          throw new Error(data?.errors?.[0]?.message ?? `HTTP ${response.status}`);
        }
      } catch (error) {
        console.error('Updates sign-up failed:', error);
        const fallback = form.querySelector<HTMLElement>('[data-error="form"]')!;
        fallback.textContent = 'Sorry, that did not go through. Please try again, or email me and I will add you.';
        fallback.classList.remove('hidden');
      } finally {
        button.disabled = false;
        button.textContent = 'Sign up';
      }
    });
  });
</script>
