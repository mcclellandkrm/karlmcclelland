---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  href: string;
}

const { entry, href } = Astro.props;
const { title, client, category, location, summary, heroImage } = entry.data;
---

<a
  href={href}
  class="group block border border-material-stone/20 bg-white transition-colors duration-300 hover:border-material-bronze/40"
>
  {heroImage && (
    <div class="aspect-[4/3] overflow-hidden bg-material-limestone">
      <Image
        src={heroImage}
        alt=""
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </div>
  )}
  <div class="p-8">
    {category.length > 0 && <span class="text-label text-material-bronze">{category.join(' · ')}</span>}
    <h3 class="mt-3 text-2xl font-display font-light text-material-charcoal">{title}</h3>
    {(client || location) && (
      <p class="mt-1 text-sm text-material-stone">{[client, location].filter(Boolean).join(' — ')}</p>
    )}
    <p class="mt-4 text-base leading-relaxed text-material-charcoal/70">{summary}</p>
  </div>
</a>
