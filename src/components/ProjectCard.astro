---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { sectorLabel } from '../data/sectors';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, sector, location, summary, heroImage, walkthroughUrl } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  class="group block border border-material-stone/20 bg-white transition-colors duration-300 hover:border-material-bronze/40"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-material-limestone">
    {heroImage ? (
      <Image
        src={heroImage}
        alt=""
        widths={[480, 800]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="flex h-full items-center justify-center">
        <span class="font-display text-2xl font-light text-material-stone">{title}</span>
      </div>
    )}
    {walkthroughUrl && (
      <span class="absolute bottom-4 left-4 bg-material-charcoal/80 px-3 py-1.5 text-label text-white">
        360° walkthrough
      </span>
    )}
  </div>
  <div class="p-8">
    <span class="text-label text-material-bronze">{sectorLabel(sector)}</span>
    <h3 class="mt-3 font-display text-2xl font-light text-material-charcoal">{title}</h3>
    {location && <p class="mt-1 text-sm text-material-stone">{location}</p>}
    <p class="mt-4 text-base leading-relaxed text-material-charcoal/70">{summary}</p>
  </div>
</a>
