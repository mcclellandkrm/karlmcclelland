---
// TODO(Karl): replace with a real 360° walkthrough still — see source-of-truth §8 open items.
const heroImage = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=2053&auto=format&fit=crop';
---

<section id="top" class="relative min-h-screen flex items-center overflow-hidden bg-black">
  <!-- Background / Texture -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroImage}
      alt="360 walkthrough showcase"
      class="w-full h-full object-cover opacity-30"
    />
    <div class="absolute inset-0 metal-overlay"></div>
    <div class="absolute inset-0 bg-black/70"></div>
  </div>

  <div class="container-wide relative z-20">
    <div class="grid gap-16 lg:grid-cols-2 lg:items-center">

      <!-- Left: Copy -->
      <div class="text-center lg:text-left">
        <h1 class="font-display font-light text-white leading-[1.05] tracking-tight mb-8">
          <span class="block whitespace-nowrap text-[clamp(2.5rem,0.9rem+4vw,5.5rem)]">Bespoke 360°</span>
          <span class="block whitespace-nowrap text-[clamp(2.5rem,0.9rem+4vw,5.5rem)] text-white/90">Walkthroughs</span>
        </h1>

        <p class="text-lg md:text-xl text-neutral-200 font-body leading-relaxed max-w-xl mx-auto lg:mx-0 mb-12">
          Turn browsers into bookers. Build trust and drive business with real 360° walkthroughs, published to Google, that feel like a luxury preview.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 justify-center lg:justify-start">
          <a href="#offerings" class="btn-primary">
            See what I do
          </a>
          <a href="#contact" class="btn-secondary">
            Get started
          </a>
        </div>
      </div>

      <!-- Right: Visual -->
      <div class="relative hidden lg:block">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden border border-white/10 shadow-xl">
          <img
            src={heroImage}
            alt="360 walkthrough showcase"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
        </div>
      </div>

    </div>
  </div>
</section>
