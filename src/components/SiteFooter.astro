---
import { Image } from 'astro:assets';
import logo from '../assets/brand/SVG/MDS-logo-wlsg.svg';
import { navLinks, site } from '../data/site';

const currentYear = new Date().getFullYear();

---

<footer class="border-t border-material-stone/20 bg-material-charcoal text-white">
  <div class="container-wide py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      <div>
        <Image src={logo} alt={site.name} class="h-9 w-auto" />
        <p class="mt-4 max-w-sm leading-relaxed text-white/60">
          {site.tagline}
        </p>
        <a
          href={site.linkedinHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex h-10 w-10 items-center justify-center border border-white/20 text-white/60 transition-colors duration-300 hover:border-white hover:text-white"
          aria-label="LinkedIn"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>
      </div>

      <div>
        <p class="text-label text-white/40">Navigate</p>
        <ul class="mt-6 space-y-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 transition-colors duration-300 hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-label text-white/40">Get In Touch</p>
        <ul class="mt-6 space-y-3 text-white/70">
          <li><a href={`mailto:${site.email}`} class="transition-colors duration-300 hover:text-white">{site.email}</a></li>
          <li><a href={site.phoneHref} class="transition-colors duration-300 hover:text-white">{site.phoneDisplay}</a></li>
          <li><a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="transition-colors duration-300 hover:text-white">WhatsApp</a></li>
          <li>{site.base}</li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-white/40 md:flex-row">
      <p>© {currentYear} {site.name}.</p>
      <p>360° virtual tours · Google Street View · Photography · Websites</p>
    </div>
  </div>
</footer>
