---
import ClientLogos from './ClientLogos.astro';
---

<section class="section bg-white relative overflow-hidden">
  <!-- Subtle background pattern -->
  <div
    class="absolute inset-0 opacity-[0.015]"
    style="background-image: radial-gradient(circle, black 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <div class="container-wide relative z-10">

    <!-- Stats Row -->
    <div data-reveal class="grid grid-cols-3 gap-6 pb-12 mb-12 border-b border-neutral-200">
      <div>
        <div class="text-4xl font-display font-light text-accent-warm mb-1">60M+</div>
        <div class="text-label">Views Generated across Google</div>
      </div>
      <div>
        <div class="text-4xl font-display font-light text-accent-warm mb-1">10+</div>
        <div class="text-label">Years Experience</div>
      </div>
      <div>
        <div class="text-4xl font-display font-light text-accent-warm mb-1">80+</div>
        <div class="text-label">Businesses Transformed</div>
      </div>
    </div>

    <!-- Google Certified + Client Logos -->
    <div data-reveal style="transition-delay: 0.1s" class="mb-16">
      <!-- Google Badge -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <img
          src="/logos/googlelogos/streetview-logo.svg"
          alt="Google Street View"
          class="w-12 h-12"
        />
        <div>
          <div class="text-lg font-semibold text-black">Google Certified</div>
          <div class="text-sm font-medium text-neutral-500">Trusted Photographer</div>
        </div>
      </div>

      <!-- Client Logos -->
      <ClientLogos />
    </div>

    <!-- Testimonial -->
    <div data-reveal style="transition-delay: 0.2s" class="max-w-3xl mx-auto text-center">
      <blockquote class="text-xl leading-relaxed text-neutral-700 mb-6 italic font-body">
        "We've noticed a big increase in public awareness of who we are, what we offer and how to find out and that is definitely helping sales. Excellent work and value for money."
      </blockquote>
      <cite class="text-label text-brand-stone">
        Chris Suitor, Suitor Brothers Menswear
      </cite>
    </div>

  </div>
</section>
