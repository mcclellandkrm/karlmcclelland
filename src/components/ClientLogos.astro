---
import { Image } from 'astro:assets';
import bandqLogo from '../assets/client-logos/bandq-logo.svg';
import eaLogo from '../assets/client-logos/ea-logo.svg';
import gohLogo from '../assets/client-logos/goh-logo.svg';
import hiltiLogo from '../assets/client-logos/hilti-logo.svg';
import hyundaiLogo from '../assets/client-logos/hyundai-logo.svg';
import lyricLogo from '../assets/client-logos/lyric-logo.svg';
import niScreenLogo from '../assets/client-logos/ni-screen-logo.png';
import odysseyLogo from '../assets/client-logos/odyssey-logo.svg';
import skodaLogo from '../assets/client-logos/skoda-logo.svg';
import sseLogo from '../assets/client-logos/sse-logo.svg';
import toyotaLogo from '../assets/client-logos/toyota-logo.svg';

const clients = [
  { name: 'Toyota', logo: toyotaLogo },
  { name: 'Hyundai', logo: hyundaiLogo },
  { name: 'Skoda', logo: skodaLogo },
  { name: 'EA', logo: eaLogo },
  { name: 'B&Q', logo: bandqLogo },
  { name: 'Hilti', logo: hiltiLogo },
  { name: 'SSE', logo: sseLogo },
  { name: 'NI Screen', logo: niScreenLogo },
  { name: 'Lyric Theatre', logo: lyricLogo },
  { name: 'Odyssey Arena', logo: odysseyLogo },
  { name: 'Grand Opera House', logo: gohLogo },
];

// Doubled for a seamless infinite scroll
const duplicatedClients = [...clients, ...clients];
---

<div class="py-12 bg-neutral-50 border border-neutral-200 rounded-lg">
  <!-- Header -->
  <div data-reveal class="text-center mb-8">
    <span class="text-[10px] font-mono tracking-[0.3em] text-neutral-500 mb-4 block">
      TRUSTED BY
    </span>
    <h3 class="text-2xl md:text-3xl font-display text-black font-light">
      Industry Leaders
    </h3>
  </div>

  <!-- Scrolling Carousel -->
  <div class="relative">
    <!-- Fade edges -->
    <div class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-neutral-50 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-neutral-50 to-transparent z-10 pointer-events-none"></div>

    <!-- Carousel Track -->
    <div class="overflow-hidden">
      <div class="flex items-center gap-20 animate-scroll" style="width: max-content;">
        {duplicatedClients.map((client, index) => (
          <div class="flex-shrink-0 group flex items-center justify-center py-6 px-4 transition-all duration-500">
            <Image
              src={client.logo}
              alt={client.name}
              class="h-10 md:h-12 w-auto object-contain opacity-60 group-hover:opacity-100 transition-opacity duration-500"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll 40s linear infinite;
  }

  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>
