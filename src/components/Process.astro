---
const steps = [
  {
    number: '01',
    title: 'Consultation',
    description: 'We discuss your space, goals, and timeline. I understand your business and create a tailored approach.',
  },
  {
    number: '02',
    title: 'Capture & Creation',
    description: 'I visit your location for 1-2 hours of professional 360° photography and walkthrough creation.',
  },
  {
    number: '03',
    title: 'Launch & Optimize',
    description: 'Within 14 days: live walkthrough, high-res images, Google integration, and optimization guidance.',
  },
];
---

<section id="process" class="section bg-black relative overflow-hidden">
  <!-- Subtle grid pattern -->
  <div
    class="absolute inset-0 opacity-[0.02]"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"
  ></div>

  <div class="container-wide relative z-10">

    <!-- Header -->
    <div data-reveal class="text-center mb-20">
      <h2 class="text-4xl md:text-5xl font-display text-white mb-4 font-light">
        How It Works
      </h2>
      <p class="text-label text-neutral-400">
        Simple. Fast. Effective.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {steps.map((step, index) => (
        <div
          data-reveal
          style={`transition-delay: ${index * 0.1}s`}
          class="group relative bg-neutral-900 border border-neutral-800 p-8 hover:border-white hover:bg-neutral-800 transition-all duration-500"
        >
          <!-- Step Number -->
          <div class="mb-6">
            <span class="text-[10px] font-mono text-neutral-400 tracking-[0.2em]">
              STEP
            </span>
            <div class="text-4xl font-display font-light text-white mt-1">
              {step.number}
            </div>
          </div>

          <!-- Content -->
          <h3 class="text-xl font-display text-white mb-4 font-light">
            {step.title}
          </h3>
          <p class="text-neutral-300 leading-relaxed font-body">
            {step.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
