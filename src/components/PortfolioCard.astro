---
import type { PortfolioItem } from '../data/portfolio';

interface Props extends PortfolioItem {
  delay?: number;
}

const { name, type, location, tourUrl, description, delay = 0 } = Astro.props;
---

<div
  data-reveal
  style={delay ? `transition-delay: ${delay}s` : undefined}
  class="group relative flex flex-col justify-between overflow-hidden border border-neutral-800 hover:border-accent-warm/50 bg-neutral-900 p-8 min-h-[320px] transition-all duration-500"
>
  <div class="absolute inset-0 metal-overlay opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>

  <div class="relative">
    <span class="text-neutral-300 text-sm uppercase tracking-[0.2em]">
      {type}
    </span>
    <h4 class="text-xl font-display text-white font-light mt-3 mb-2">
      {name}
    </h4>
    <p class="text-neutral-400 text-sm mb-3">
      {location}
    </p>
    <p class="text-neutral-300 text-sm leading-relaxed">
      {description}
    </p>
  </div>

  <a
    href={tourUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative mt-8 btn-ghost inline-flex items-center gap-2 self-start"
  >
    View walkthrough
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </a>
</div>
