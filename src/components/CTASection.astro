---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tone?: 'charcoal' | 'forest';
  backgroundImage?: ImageMetadata;
  parallax?: boolean;
  steps?: { title: string; body: string }[];
}

const {
  eyebrow,
  title,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  tone = 'charcoal',
  backgroundImage,
  parallax = false,
  steps = [],
} = Astro.props;

const toneClass = tone === 'forest' ? 'bg-material-forest' : 'bg-material-charcoal';

const optimizedBg = backgroundImage
  ? await getImage({ src: backgroundImage, width: 2400, format: 'webp' })
  : null;
---

<section class:list={['section relative overflow-hidden text-white', !optimizedBg && toneClass]}>
  {optimizedBg && (
    <>
      <div
        class:list={[
          'absolute inset-0 bg-cover bg-center',
          parallax && '[@media(hover:hover)_and_(pointer:fine)]:bg-fixed',
        ]}
        style={{ backgroundImage: `url(${optimizedBg.src})` }}
      >
      </div>
      <div class="absolute inset-0 bg-material-charcoal/60"></div>
    </>
  )}
  <div class="container-wide relative text-center">
    {eyebrow && <span class="text-label text-material-bronze">{eyebrow}</span>}
    <h2 class="mt-4 font-display font-light text-white">{title}</h2>
    {body && <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-white/70">{body}</p>}
    {steps.length > 0 && (
      <ol class="mx-auto mt-14 grid max-w-5xl grid-cols-1 gap-10 text-left md:grid-cols-3">
        {steps.map((step, index) => (
          <li class="border-t border-white/20 pt-6">
            <span class="text-label text-material-oak">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-2xl font-light text-white">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-white/70">{step.body}</p>
          </li>
        ))}
      </ol>
    )}
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={primaryHref}
        {...(primaryHref.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        class="inline-flex items-center justify-center gap-2 border-2 border-material-limestone bg-material-limestone px-8 py-4 text-xs font-semibold uppercase tracking-wider text-material-charcoal transition-colors duration-300 hover:bg-transparent hover:text-material-limestone"
      >
        {primaryLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          {...(secondaryHref.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class="inline-flex items-center justify-center gap-2 border-2 border-white/30 px-8 py-4 text-xs font-semibold uppercase tracking-wider text-white transition-colors duration-300 hover:border-white"
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
